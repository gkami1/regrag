# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# App
LOG_LEVEL=INFO
# Self-hosted LLM (vLLM, OpenAI-compatible API). Reach a rented GPU through an
# SSH tunnel (ssh -L 8000:localhost:8000 user@host); never expose the port.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_API_KEY=

# LLM judge for generation evaluation (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=
